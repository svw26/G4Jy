<FIELD arraysize="9" datatype="char" name="G4Jy_name" ucd="meta.id.parent;src">
<DESCRIPTION>Name of source belonging to the G4Jy Sample</DESCRIPTION>
</FIELD>
<FIELD arraysize="29" datatype="char" name="NED_name" ucd="meta.id.cross;src">
<DESCRIPTION>Alternative name for the G4Jy source in NED</DESCRIPTION>
</FIELD>
<FIELD arraysize="9" datatype="char" name="classification" ucd="meta.code">
<DESCRIPTION>Source-type classification</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="ncmp_GLEAM" ucd="meta.number;em.radio.170-231MHz">
<DESCRIPTION>Number of GLEAM components for this G4Jy source</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD datatype="double" name="centroid_RAJ2000" ucd="pos.eq.ra;meta.main;em.radio.750-1500MHz" unit="deg">
<DESCRIPTION>Right ascension for the centroid position (J2000)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="err_centroid_RAJ2000" ucd="stat.error;pos.eq.ra;em.radio.750-1500MHz" unit="arcsec">
<DESCRIPTION>Error on RA for the centroid position</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="centroid_DEJ2000" ucd="pos.eq.dec;meta.main;em.radio.750-1500MHz" unit="deg">
<DESCRIPTION>Declination for the centroid position (J2000)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="err_centroid_DEJ2000" ucd="stat.error;pos.eq.dec;em.radio.750-1500MHz" unit="arcsec">
<DESCRIPTION>Error on Dec for the centroid position</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="centroid_flag" ucd="meta.code.qual;em.radio.750-1500MHz">
<DESCRIPTION>Flag for sources with an updated centroid-position</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD arraysize="7" datatype="char" name="morphology" ucd="src.morph;em.radio">
<DESCRIPTION>Morphology of the source in NVSS/SUMSS/TGSS</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="ncmp_NVSSorSUMSS" ucd="meta.number;em.radio.750-1500MHz">
<DESCRIPTION>Number of NVSS/SUMSS components</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD datatype="short" name="confusion_flag" ucd="meta.code.qual;em.radio.750-1500MHz">
<DESCRIPTION>Flag for sources affected by confusion in GLEAM</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD datatype="char" name="angular_size_limit" ucd="meta.code.error;em.radio.750-1500MHz">
